/target
**/*.rs.bk
.DS_Store
# Claude Code session state (worktrees, settings) — local tooling, not code.
/.claude/*
!/.claude/skills/
# .dive/ carries repo config, plans, and tools for CI; everything else
# under it (embedded DB state, scratch) stays ignored.
/.dive/*
!/.dive/config.toml
!/.dive/plans/
!/.dive/tools/
!/.dive/evals/
!/.dive/packs/
!/.dive/packs.lock
*.db
mise.local.toml
__pycache__/
